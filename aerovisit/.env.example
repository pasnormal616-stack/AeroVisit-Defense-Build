# AeroVisit — environment variables (copy the names, NOT real values, into this file)
# Set them in your IDE run configuration, or in PowerShell before `mvnw spring-boot:run`:
#   $env:AEROVISIT_MAIL_PASSWORD = "your-gmail-app-password"
#
# ⚠️ Every line below is commented out on purpose. Uncomment ONLY the ones you give a real value.
# A line left as "NAME=" sets that setting to an EMPTY string, which overrides the
# application.properties fallback (e.g. empty DB_USERNAME breaks the database login,
# empty AEROVISIT_MAIL_PASSWORD stops every email, including the booking verification code).

# Staff logins: usernames "director" and "guard"
# AEROVISIT_GUARD_PASSWORD=change-me-guard
# AEROVISIT_DIRECTOR_PASSWORD=change-me-director

# AI microservice and OCR (defaults: http://localhost:8000 and C:/Program Files/Tesseract-OCR/tessdata)
# AI_SERVICE_URL=http://localhost:8000
# TESSDATA_PATH=C:/Program Files/Tesseract-OCR/tessdata

# Database (defaults: local MySQL aerovisit_db_v2, root / empty password for local XAMPP).
# On Elastic Beanstalk set all three to the RDS database.
# DB_URL=jdbc:mysql://localhost:3306/aerovisit_db_v2?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=your-db-password

# Email (Gmail SMTP, sent from PAFMuseumOfficial@gmail.com). A Gmail App Password, not the account password
# (Google Account > Security > 2-Step Verification > App passwords)
# AEROVISIT_MAIL_PASSWORD=your-gmail-app-password
# ALERT_EMAIL=director-inbox@example.com

# External APIs (the Gemini chatbot key goes in AeroVisit-AI/.env as GEMINI_API_KEY, not here)
# OPENWEATHER_API_KEY=your-openweather-key

# Public address of the site, used for links in emails (default http://localhost:8081)
# PUBLIC_BASE_URL=https://your-name.ngrok-free.dev
