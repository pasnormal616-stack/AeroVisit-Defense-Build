# AeroVisit AI service (FastAPI, main.py) - environment variables
# Copy this file to AeroVisit-AI/.env (same folder as main.py) and fill in the values. main.py reads ONLY that file;
# the Spring Boot file aerovisit/.env is a different file and is not read here. Never commit the real .env.
# Restart the AI service (python main.py) after any change: values are read once at start-up.
# Write values without quotes or spaces, e.g. GEMINI_API_KEY=AIzaSy...

# --- REQUIRED ---------------------------------------------------------------------------------------------------
# Google Gemini API key for the "Sgt. Aero" visitor chatbot (create one at https://aistudio.google.com/apikey).
# Without it the chatbot cannot answer; every other feature (forecast, sentiment, KYC) still works.
GEMINI_API_KEY=

# MySQL database (the same database as the Spring Boot backend). Defaults shown.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=aerovisit_db_v2

# --- OPTIONAL (leave commented out to keep the default) -----------------------------------------------------------
# Shared secret: when set, the AI service only answers requests carrying it. Set the SAME value as AI_INTERNAL_KEY
# in aerovisit/.env. Blank = no check (local development).
# AI_INTERNAL_KEY=a-long-random-string

# Daily cap on Gemini calls across all visitors (rolling 24 hours). 0 = no cap (default).
# The Gemini free tier allows about 20 requests per day per model.
# GEMINI_DAILY_BUDGET=0

# Address and port the service listens on (defaults 127.0.0.1 and 8000). Spring Boot expects http://localhost:8000.
# HOST=127.0.0.1
# PORT=8000

# Selfie-with-ID checks: face sharpness gate (default 40) and the score below which a face mismatch is rejected
# automatically (default 0.25; between this and the match threshold a staff member reviews it).
# KYC_MIN_FACE_SHARPNESS=40
# KYC_CLEAR_MISMATCH_BELOW=0.25
